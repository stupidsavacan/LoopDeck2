{
  "name": "loopdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "npm run build && node scripts/make-single-html.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:builtin": "vitest run tests/builtinData.test.ts",
    "test:resolver": "vitest run tests/packResolver.test.ts",
    "test:merger": "vitest run tests/packMerger.test.ts",
    "check": "npm run typecheck && npm run test",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
